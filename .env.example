# ====================================================
# BOTELLAPP - Environment Variables
# Copy this file to .env and fill in the values
# ====================================================

# ─── Database ───────────────────────────────────────
# LOCAL DEV (SQLite - default, no extra setup needed):
DATABASE_URL="file:./dev.db"

# LOCAL DEV with Docker PostgreSQL:
# DATABASE_URL="postgresql://botellapp:botellapp@localhost:5432/botellapp"

# PRODUCTION (set automatically by Render):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# ─── Authentication ──────────────────────────────────
# Generate a strong random secret (use: openssl rand -hex 32)
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# ─── App ─────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ─── Email Reports (optional) ────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu@gmail.com"
SMTP_PASS="tu-app-password"
SMTP_FROM="BOTELLAPP <tu@gmail.com>"

# ─── WhatsApp Reports (optional) ─────────────────────
# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── Turso (alternative to PostgreSQL for production) ─
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-auth-token"
